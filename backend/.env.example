# ---------------------------------------------------------------------------
# Hotela assistant - backend configuration
#
# Copy to backend/.env and fill in. backend/.env is gitignored; never commit a
# key. Precedence: the real process environment wins, then backend/.env, then
# the .env at the repository root.
# ---------------------------------------------------------------------------

# ---- provider -----------------------------------------------------------
# Only needed for generation. The embeddings run locally, so the assistant can
# still answer from the knowledge base when this key is missing or blocked.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_VERSION=v1beta
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=400
LLM_SAFETY_BLOCK_THRESHOLD=BLOCK_ONLY_HIGH
LLM_HISTORY_TURNS=6

# ---- embeddings ---------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- chunking (changing these invalidates the index: run npm run kb:build)
CHUNK_MAX_TOKENS=400
CHUNK_MIN_TOKENS=200
CHUNK_OVERLAP_TOKENS=0

# ---- retrieval ----------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
TOP_K=6
MIN_SIMILARITY=0.35
CANDIDATE_K=12
RETRIEVAL_SCRIPT_BOOST=0.05
RETRIEVAL_HYBRID=true
RETRIEVAL_HYBRID_RRF_K=60
RETRIEVAL_DEDUPE=true
RETRIEVAL_ANSWER_MIN_SIMILARITY=0.35

# ---- fallback (used when the provider cannot answer) --------------------
FALLBACK_MAX_CHUNKS=1
FALLBACK_MAX_CHARS=700

# ---- behaviour ----------------------------------------------------------
QUERY_REWRITE=true
AUTO_REBUILD_INDEX=false
HEALTH_CHECK_ON_STARTUP=true
HEALTH_CHECK_FAIL_FAST=false
HEALTH_CHECK_PROBE_PROVIDER=false
MAX_MESSAGE_CHARS=500
HANDOFF_EMAIL=hotelaapp@gmail.com
HANDOFF_WHATSAPP=
RATE_LIMIT_PER_MINUTE=60
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- observability ------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# ---- server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
